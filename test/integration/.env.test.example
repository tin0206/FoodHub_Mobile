# Copy this file to `test/integration/.env.test` (gitignored) and fill in
# real staging credentials to run the live-backend integration tests:
#
#   flutter test --tags integration
#
# These tests hit the real staging API (see API_BASE_URL below / .env) and
# create/clean up their own throwaway data. They never touch pre-existing
# recipes, favorites, or user accounts other than the two below.

TEST_USER_EMAIL=
TEST_USER_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
