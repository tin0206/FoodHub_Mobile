# Copy this file to `test/load/.env.test` (gitignored) and fill in real
# staging credentials to run the concurrency test suite:
#
#   python test/load/case1_auth_crud_test.py
#   python test/load/case2_dish_recognition_test.py
#   python test/load/case3_ingredient_detection_test.py
#   python test/load/case4_llm_chat_test.py
#
# One account is enough to get started. If the API enforces a per-user quota
# on the AI endpoints (case 2-4), add more numbered accounts (_2_, _3_, ...)
# so quota rejections don't get mistaken for a concurrency ceiling.

TEST_USER_1_EMAIL=
TEST_USER_1_PASSWORD=
# TEST_USER_2_EMAIL=
# TEST_USER_2_PASSWORD=
